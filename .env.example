NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA_ID=
# Public site origin (no trailing slash). REQUIRED in production: canonical URLs, hreflang, sitemap.xml,
# JSON-LD, /llms.txt and link previews all use it. Without it the request host is used and pages render per request.
# Example: https://your-domain.com
NEXT_PUBLIC_SITE_URL=

# Cloudflare Pages: Settings → Variables (Production + Preview). Redeploy after edits.

# --- CV analytics: Cloudflare D1 only (REST API) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Database UUID from Workers & Pages → D1 (not the display name). Token needs Account → D1 → Edit.
CLOUDFLARE_D1_DATABASE_ID=

# Optional (npm run dev only): in-memory stats, no D1. Resets when the dev server restarts.
# CV_ANALYTICS_MEMORY=1

# /admin — both required (non-empty). Restart dev after editing .env.local
ADMIN_PASSWORD=
# e.g. openssl rand -hex 32
ADMIN_SESSION_SECRET=

# --- Blog ---
# Posts, likes and comments live in the same D1 database (tables blog_*, created automatically).
# In `npm run dev` without the D1 variables, a local SQLite file (data/blog-dev.sqlite) is used instead.
# Optional spam protection for comments (Cloudflare Turnstile → Add site). Leave empty to disable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Pauzo app API (/api/pauzo/*) — same D1 database, tables pauzo_* are created automatically ---
# Google AI Studio key for the in-app money coach (Gemini). Leave empty to disable /api/pauzo/insights.
PAUZO_GEMINI_API_KEY=
# PAUZO_GEMINI_MODEL= (empty = newest gemini-X-flash available to the key)
# Questions per device per day (default 2).
# PAUZO_AI_DAILY_LIMIT=10
# Code store reviewers can enter to unlock without a partner, e.g. PZ-REV7W. Keep it private.
PAUZO_REVIEWER_CODE=
# Push «your friend joined» (Firebase → Project settings → Service accounts → private key JSON, raw or base64).
PAUZO_FCM_SERVICE_ACCOUNT=
# One-time unlock purchase (product id must match the stores; default pauzo_unlock).
# PAUZO_UNLOCK_PRODUCT_ID=pauzo_unlock
# Google Play: service account JSON with access granted in Play Console → Users and permissions.
PAUZO_PLAY_SERVICE_ACCOUNT=
# App Store Server API (App Store Connect → Users and Access → Integrations → In-App Purchase key).
PAUZO_APPLE_ISSUER_ID=
PAUZO_APPLE_KEY_ID=
PAUZO_APPLE_PRIVATE_KEY=
# PAUZO_APPLE_BUNDLE_ID=com.pauzo.app
# Invite links open the app: Play Console → Setup → App signing → SHA-256 (comma-separated), Apple team id, App Store URL.
PAUZO_ANDROID_CERT_SHA256=
PAUZO_APPLE_TEAM_ID=
PAUZO_IOS_APP_URL=
