{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "cv-site",
  "compatibility_date": "2026-04-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "cv-site"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  // Workers AI: Ask Pauzo answers here first, Gemini is the fallback.
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  },
  // Variables and secrets live in the Cloudflare dashboard; without this,
  // every git deploy replaced them with the (empty) set in this file.
  "keep_vars": true
}
